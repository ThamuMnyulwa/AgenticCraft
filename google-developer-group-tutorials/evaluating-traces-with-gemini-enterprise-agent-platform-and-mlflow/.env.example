# Google Cloud project. Holds the Gemini API key secret, and runs Part 2.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1

# GCS bucket for Terraform state. Defaults to <project>-tfstate. Create it with ./demo.sh tf-bootstrap.
TF_STATE_BUCKET=

# Optional AI Studio route (the demo code uses the Agent Platform instead):
# Secret Manager secret with a Gemini API key. ./demo.sh api-key creates it if missing.
GEMINI_SECRET_ID=gemini-api-key

# Local copy of that key, filled by ./demo.sh api-key. Not read by the demo code.
GEMINI_API_KEY=
