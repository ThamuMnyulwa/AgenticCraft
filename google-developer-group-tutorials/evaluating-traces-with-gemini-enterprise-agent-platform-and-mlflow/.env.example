# Google Cloud project. Holds the Gemini API key secret, and runs Part 2.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1

# Secret Manager secret with the Gemini API key. ./demo.sh api-key creates it if missing.
GEMINI_SECRET_ID=gemini-api-key

# Local copy of the key. ./demo.sh api-key fills it from Secret Manager.
# When set, it is used directly; leave it empty to read Secret Manager on every run.
GEMINI_API_KEY=
